# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GANTI_DENGAN_KEY_KAMU

# Ganti dengan domain produksi Vercel yang benar.
NEXT_PUBLIC_APP_URL=https://NAMA-PROJECT.vercel.app
APP_ALLOWED_ORIGINS=https://NAMA-PROJECT.vercel.app
NEXT_PUBLIC_APP_STAGE=production
NEXT_PUBLIC_GIT_COMMIT_SHA=manual-upload

# Opsional. Biarkan kosong bila belum memakai Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
