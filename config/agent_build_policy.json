{
  "sourceCodeIncluded": false,
  "implementationOwner": "Antigravity Agent Mode",
  "buildStrategy": "vertical-slices",
  "oneWriterPerFile": true,
  "requirePlanBeforeCode": true,
  "requireBrowserEvidence": true,
  "requiredChecks": [
    "lint",
    "typecheck",
    "unit-tests",
    "e2e-critical-flows",
    "production-build",
    "secret-scan",
    "RLS-negative-tests"
  ],
  "releaseOrder": [
    "local",
    "preview",
    "smoke-test",
    "production"
  ],
  "prohibited": [
    "fake-completion",
    "placeholder-only-features",
    "client-secrets",
    "unofficial-government-login-automation",
    "AI-before-approval"
  ]
}
