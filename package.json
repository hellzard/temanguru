{
  "name": "temanguru",
  "version": "0.4.1",
  "private": true,
  "description": "Teman Guru — guest-first workspace dengan Antigravity Autopilot, login opsional, backup lokal, dan sinkronisasi Supabase",
  "license": "MIT",
  "engines": {
    "node": ">=22.x"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:tenant-context": "node scripts/check-membership-context.mjs",
    "verify:workspace": "node scripts/verify-project.mjs",
    "verify": "npm run verify:workspace && npm run verify:guest-first && npm run check:secrets && npm run check:tenant-context && npm run lint && npm run typecheck && npm run test && npm run build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --no-backup",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db",
    "verify:database": "npm run supabase:reset && npm run supabase:test",
    "verify:full": "npm run verify && npm run test:e2e",
    "preflight": "node scripts/preflight-deploy.mjs",
    "doctor": "node scripts/antigravity-doctor.mjs",
    "verify:guest-first": "node scripts/verify-guest-first.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "clsx": "2.1.1",
    "idb": "8.0.3",
    "lucide-react": "1.27.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tailwind-merge": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "30.0.1",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "supabase": "2.111.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {}
}
