# Public Supabase values.
# The publishable key is designed for public clients, but RLS must protect every user-owned table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local: http://localhost:3000
# Production: https://temanguru.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional anti-abuse layer for public forms. Leave empty during local starter work.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI is intentionally not configured in this phase.
